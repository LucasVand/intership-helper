{
  "name": "intership-helper",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio --port 4983",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:down:volume": "docker compose down -v",
    "db:wait": "bash scripts/wait-for-db.sh",
    "db:logs": "docker logs -f intership-helper-postgres",
    "db:ps": "docker compose ps",
    "db:restart": "npm run db:down && npm run db:up && npm run db:wait",
    "db:setup": "npm run db:up && npm run db:wait && npm run db:migrate && npm run db:sync",
    "db:setup:clear": "npm run db:down:volume && npm run db:setup",
    "db:reset": "npm run db:down:volume && npm run db:setup",
    "db:sync": "tsx scripts/sync-internships.ts && npm run db:prune",
    "db:sync:dry": "tsx scripts/sync-internships.ts --dry-run",
    "db:prune": "tsx scripts/prune-sync-history.ts",
    "db:dedupe": "tsx scripts/dedupe-normalized.ts --dry-run",
    "db:dedupe:apply": "tsx scripts/dedupe-normalized.ts --apply",
    "dev:db": "npm run db:setup && npm run dev",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "next": "16.3.4",
    "node-fetch": "^2.7.0",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/cheerio": "^0.22.35",
    "@types/node": "^20.19.43",
    "@types/node-fetch": "^2.6.13",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  }
}
